# ==== AgencyHub — variáveis de ambiente ====
# Copie para .env.local (dev) ou configure no host (produção).

# --- Obrigatórias em produção ---
# Chave da Anthropic (gera todo o conteúdo de IA). Sem ela, nada de IA funciona.
ANTHROPIC_API_KEY=sk-ant-...

# Segredo para assinar as sessões de login. Gere uma string longa e aleatória:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria

# Senha inicial das contas seed (admin/agencia). Troque após o primeiro acesso.
SEED_PASSWORD=defina-uma-senha-forte

# Liga o bloqueio de IA por saldo/plano (recomendado em produção pra não estourar custo).
BILLING_ENFORCED=true

# Porta (o Dockerfile usa 3000; ajuste conforme o host).
PORT=3000

# --- Opcionais ---
# Geração de imagem (mockup fiel com Google; conceitos com Together/HuggingFace).
GOOGLE_AI_API_KEY=
TOGETHER_API_KEY=
HF_API_KEY=

# Webhooks da Meta (WhatsApp/Instagram) — token de verificação do webhook.
META_VERIFY_TOKEN=agencyhub-verify

# Webhook de vendas (Shopify/Mercado Livre) — se definido, exige ?token= igual.
SALES_WEBHOOK_SECRET=

# Mercado Pago (pagamentos: coins + planos, via Checkout Pro + webhook).
# Access Token da sua aplicação MP (produção: começa com APP_USR; teste: TEST-).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL pública do app (para back_urls e notification_url do checkout).
APP_URL=https://marqa.online
