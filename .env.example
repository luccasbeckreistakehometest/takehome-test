# ==== Marqa — variáveis de ambiente ====
# Copie para .env.local (dev) ou .env (produção, permissão 600). Detalhes em docs/DEPLOY.md.
# Gere segredos no próprio servidor:  openssl rand -hex 32

# --- Obrigatórias em produção ---
# Assina as sessões (mínimo 32 caracteres). Também é build arg: build e runtime usam o mesmo valor.
AUTH_SECRET=
# URL pública (links, canonical, sitemap, retorno e webhook do Mercado Pago).
APP_URL=https://marqa.online
# Senha das contas seed admin/agencia (só usada se elas ainda não existirem; mínimo 8).
SEED_PASSWORD=
# Chave da Anthropic (console) com crédito. Sem ela, tudo funciona menos a IA.
ANTHROPIC_API_KEY=
# Mercado Pago (produção: APP_USR-...). Com o token, a assinatura no cartão
# (preapproval) aparece em /plans e na landing; no painel do MP, ligue os
# tópicos de webhook payment, subscription_preapproval e
# subscription_authorized_payment apontando para APP_URL/api/webhooks/mercadopago.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Planos grátis param sempre que os coins acabam. true estende o bloqueio aos
# planos pagos e à agência da casa (antes de ligar, dê um plano a ela em /admin).
BILLING_ENFORCED=false

# --- Custos e limites (padrões entre parênteses) ---
# Teto diário GLOBAL de gasto de IA em US$ (20). 0 desliga a IA.
AI_DAILY_SPEND_LIMIT_USD=20
# Bolso diário de todas as contas grátis juntas (25% do global).
# AI_FREE_DAILY_SPEND_LIMIT_USD=5
# Teto diário por conta: grátis (1) e paga (50% do global). A casa só tem o global.
# AI_FREE_ACCOUNT_DAILY_SPEND_LIMIT_USD=1
# AI_PAID_ACCOUNT_DAILY_SPEND_LIMIT_USD=10
# AI_RATE_LIMIT_PER_10MIN=40
# AI_RATE_LIMIT_PER_IP_10MIN=80
# TTS_RATE_LIMIT_PER_10MIN=30
# TTS_RATE_LIMIT_PER_IP_10MIN=60
# LOGIN_RATE_LIMIT_PER_IP=30
# LOGIN_RATE_LIMIT_PER_ACCOUNT=8
# REGISTER_RATE_LIMIT_PER_HOUR=5
# CONTACT_RATE_LIMIT_PER_HOUR=5
LEAD_RATE_LIMIT_PER_HOUR=5
# Páginas públicas da rodada 3 (por IP): decisões no link de aprovação e
# "já paguei" da fatura (30/10 min), leituras de /aprovar, /fatura, /b e
# imagens assinadas (300/10 min) e o beacon de analytics /api/t (120/min).
# PUBLIC_DECISION_RATE_LIMIT_PER_10MIN=30
# PUBLIC_READ_RATE_LIMIT_PER_10MIN=300
# ANALYTICS_RATE_LIMIT_PER_MIN=120
# Voz: caracteres de fala por conta por dia (6000). Passou disso, só texto.
# TTS_DAILY_CHARS_PER_ACCOUNT=6000
# Câmbio usado no admin (Custos de IA) para comparar gasto em US$ com receita em R$ (5.5).
# USD_BRL_RATE=5.5

# --- Cadastro, identidade legal e suporte ---
# Cadastro público de agências: aberto (cada agência ganha o próprio workspace)
# quando LEGAL_NAME, LEGAL_DOCUMENT e LEGAL_EMAIL estão preenchidos (em
# produção, sem eles fica fechado). false fecha o cadastro (vira "pedir acesso").
AGENCY_SELF_SIGNUP=
# Aparecem nas páginas legais e no rodapé só quando preenchidos.
LEGAL_NAME=
LEGAL_DOCUMENT=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Canais extras na página de contato (WhatsApp com DDI, só dígitos).
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# --- Voz da IA (nunca a do navegador) ---
# Preferido: ElevenLabs (multilingual). Alternativa: OpenAI TTS. Sem nenhum, só texto.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# --- Integrações opcionais ---
# Webhook da Meta: App Secret (valida a assinatura; sem ele todo POST é recusado)
# e token de verificação (aleatório, 16+ caracteres).
META_APP_SECRET=
META_VERIFY_TOKEN=
# Ao salvar um número/conta, a Graph API confirma que o token tem acesso ao id.
# META_GRAPH_VERIFY=off só existe para o e2e — nunca em produção.
# Token global opcional do webhook de vendas (o normal é o token por cliente).
SALES_WEBHOOK_SECRET=
# Imagens (também configuráveis pelo admin).
GOOGLE_AI_API_KEY=
TOGETHER_API_KEY=
HF_API_KEY=
# Modo sessão do WhatsApp (worker local com Chrome). Deixe vazio na imagem de produção.
MESSAGING_SESSION_MODE=

# --- Só para testes (NUNCA em produção) ---
# MP_TRANSPORT=file  → Mercado Pago falso em arquivo (e2e da assinatura)
# TRACKING_TEST_MODE=1 → o analytics conta navegadores headless (e2e)
# AI_MOCK=1 → respostas de exemplo sem chamar a Anthropic
